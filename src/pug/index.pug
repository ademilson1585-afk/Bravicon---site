doctype html
html(lang='pt-BR')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description', content='Bravicon Calhas em Sorocaba: fabricação, instalação, limpeza e manutenção de calhas, rufos, pingadeiras e condutores.')
    meta(name='robots', content='index, follow')
    link(rel='canonical', href='https://bravicon.com.br/')
    meta(property='og:title', content='Bravicon Calhas em Sorocaba')
    meta(property='og:description', content='Calhas, rufos, pingadeiras, condutores e manutenção de telhados em Sorocaba e região.')
    title Bravicon Calhas em Sorocaba | Calhas e Rufos
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')
    link(href='https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700,800', rel='stylesheet')
    link(href='css/styles.css', rel='stylesheet')
    link(href='css/bravicon.css', rel='stylesheet')
    script(type='application/ld+json').
      {"@context":"https://schema.org","@type":"HomeAndConstructionBusiness","name":"Bravicon Calhas em Sorocaba","legalName":"Bravicon Comércio e Serviços Ltda.","url":"https://bravicon.com.br/","telephone":"+55 15 99179-6710","address":{"@type":"PostalAddress","addressLocality":"Sorocaba","addressRegion":"SP","addressCountry":"BR"},"areaServed":["Sorocaba","Votorantim"],"description":"Fabricação, instalação, limpeza e manutenção de calhas, rufos, pingadeiras e condutores."}
  body#page-top.bravicon-site
    nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container
        a.navbar-brand(href='#page-top')
          span.brand-mark B
          span.brand-name BRAVI
          span.brand-accent CON
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-label='Abrir menu')
          | Menu 
          i.fas.fa-bars
        #navbarResponsive.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item: a.nav-link(href='#servicos') Serviços
            li.nav-item: a.nav-link(href='#diferenciais') Diferenciais
            li.nav-item: a.nav-link(href='#atendimento') Atendimento
            li.nav-item: a.nav-link(href='#contato') Contato

    header.masthead.bravicon-hero
      .container
        .row.align-items-center
          .col-lg-8
            .eyebrow Fabricação e instalação sob medida
            h1.masthead-heading Bravicon Calhas em Sorocaba
            p.hero-copy Proteção completa para seu imóvel com calhas, rufos, pingadeiras e condutores produzidos para cada obra.
            a.btn.btn-primary.btn-xl(href='https://wa.me/5515991796710?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20Bravicon%20Calhas%20em%20Sorocaba%20e%20gostaria%20de%20um%20or%C3%A7amento.', target='_blank', rel='noopener')
              i.fab.fa-whatsapp.me-2
              | Pedir orçamento
            a.btn.btn-outline-light.btn-xl.ms-lg-3.mt-3.mt-lg-0(href='#servicos') Ver serviços
          .col-lg-4.d-none.d-lg-block
            .hero-shape
              i.fas.fa-house-chimney.fa-5x
              .water-line

    section#servicos.page-section
      .container
        .text-center
          .section-kicker Soluções para sua cobertura
          h2.section-heading Calhas e serviços em Sorocaba
          p.section-subheading.text-muted Atendimento residencial, comercial e condominial em Sorocaba, Votorantim e região.
        .row.g-4
          each item in [{icon:'fa-water',title:'Calhas sob medida',text:'Calhas moldura, cocho e outros modelos fabricados conforme as medidas da obra.'},{icon:'fa-ruler-combined',title:'Rufos e pingadeiras',text:'Rufos, contra-rufos e pingadeiras para proteger paredes, muros e telhados.'},{icon:'fa-arrow-down-long',title:'Condutores e bocais',text:'Dimensionamento e instalação para o correto escoamento da água da chuva.'},{icon:'fa-screwdriver-wrench',title:'Limpeza e manutenção',text:'Limpeza, revisão de emendas, bocais, cabeceiras e correção de vazamentos.'},{icon:'fa-house',title:'Telhados e vedação',text:'Troca de telhas, vedação de parafusos e cumeeiras, passarinheiras e reparos.'},{icon:'fa-industry',title:'Peças especiais',text:'Colarinhos, fechamentos, dutos, coifas, mata-canal e chapéu chinês.'}]
            .col-md-6.col-lg-4
              .service-card.h-100
                .service-icon: i.fas(class=item.icon)
                h3=item.title
                p=item.text
                a.service-link(href='https://wa.me/5515991796710?text=Ol%C3%A1%21%20Quero%20um%20or%C3%A7amento%20da%20Bravicon%20Calhas%20em%20Sorocaba.', target='_blank', rel='noopener') Solicitar orçamento

    section#diferenciais.page-section.bg-light
      .container
        .row.align-items-center.g-5
          .col-lg-6
            .section-kicker Serviço direto e transparente
            h2.section-heading Por que escolher a Bravicon?
            p.lead.text-muted Avaliamos o local, produzimos as peças e realizamos a instalação com atenção aos pontos de vedação e escoamento.
            ul.benefit-list
              li: span.check ✓
                | Peças fabricadas sob medida
              li: span.check ✓
                | Atendimento em Sorocaba e região
              li: span.check ✓
                | Orçamento detalhado pelo WhatsApp
              li: span.check ✓
                | Garantia de 1 ano para o serviço de vedação
          .col-lg-6
            .info-panel
              .info-panel-top
                i.fas.fa-cloud-rain
                strong Proteja seu imóvel das infiltrações
              p Calhas entupidas, emendas abertas e rufos mal vedados podem levar água para paredes, forros e fachadas. A manutenção preventiva custa menos que o reparo dos danos.
              a.btn.btn-primary(href='https://wa.me/5515991796710?text=Ol%C3%A1%21%20Preciso%20de%20uma%20avalia%C3%A7%C3%A3o%20de%20calhas.', target='_blank', rel='noopener') Agendar avaliação

    section#atendimento.page-section
      .container
        .text-center
          .section-kicker Atendimento local
          h2.section-heading Calhas em Sorocaba e Votorantim
          p.section-subheading.text-muted Atendemos casas, comércios, condomínios, galpões e instituições. Nossa base fica na região do Wanel Ville.
        .row.g-4.text-center
          each area in [{icon:'fa-location-dot',title:'Sorocaba',text:'Atendimento em todas as regiões da cidade.'},{icon:'fa-map-location-dot',title:'Votorantim',text:'Visitas e serviços mediante agendamento.'},{icon:'fa-calendar-check',title:'Horário agendado',text:'Confirmamos o atendimento antes do deslocamento.'}]
            .col-md-4
              .area-card
                i.fas(class=area.icon)
                h3=area.title
                p=area.text

    section#contato.page-section.contact-cta
      .container.text-center
        h2 Precisa de calhas em Sorocaba?
        p Envie fotos e medidas pelo WhatsApp para receber uma orientação inicial e agendar seu orçamento.
        a.btn.btn-light.btn-xl(href='https://wa.me/5515991796710?text=Ol%C3%A1%21%20Vim%20pelo%20site%20Bravicon%20Calhas%20em%20Sorocaba.%20Quero%20enviar%20fotos%20para%20um%20or%C3%A7amento.', target='_blank', rel='noopener')
          i.fab.fa-whatsapp.me-2
          | Falar com a Bravicon

    footer.footer.py-4
      .container
        .row.align-items-center.g-3
          .col-lg-7.text-lg-start
            strong Bravicon Calhas em Sorocaba
            br
            small Bravicon Comércio e Serviços Ltda. • Sorocaba/SP
          .col-lg-5.text-lg-end
            a.footer-link(href='https://wa.me/5515991796710', target='_blank', rel='noopener') WhatsApp
            span.mx-2 •
            a.footer-link(href='#page-top') Voltar ao topo
    a.whatsapp-float(href='https://wa.me/5515991796710?text=Ol%C3%A1%21%20Gostaria%20de%20um%20or%C3%A7amento%20de%20calhas%20em%20Sorocaba.', target='_blank', rel='noopener', aria-label='Falar pelo WhatsApp')
      i.fab.fa-whatsapp
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
    script(src='js/scripts.js')
